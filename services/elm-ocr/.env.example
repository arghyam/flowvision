# Copy to .env (next to this file) for local runs, or set these in the ECS task definition, the Kubernetes Deployment or
# /etc/meter-reader.env (secrets from AWS Secrets Manager or a Kubernetes Secret). Never commit .env.
# Keep comments on their own lines: Docker's --env-file does not strip comments after a value.
# Every other setting lives in src/conf/config.yaml; the METER_* variables below override it per deployment.

# ---- Required: the API key of the model provider in use ----
OPENAI_API_KEY=
# The model that reads the photos: openai (GPT-6 Sol, the default) or claude (Claude Sonnet 5.5, not yet evaluated on
# our photos). With claude, set ANTHROPIC_API_KEY instead of OPENAI_API_KEY. Restart the service after changing it.
# METER_PROVIDER=openai
# ANTHROPIC_API_KEY=
# Only if that key is not scoped to a workspace (it starts with sk-ant-usr): the workspace to use, from the Claude Console
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# ---- Required when METER_ENV=production (the service refuses to start without them) ----
# METER_ENV=production
# Clients (the central JalSoochak system) send this in the X-API-Key header. Comma-separate two keys to rotate.
# At least 16 random characters (e.g. openssl rand -hex 24); placeholders like change-me are refused.
# METER_SERVICE_API_KEY=
# PostgreSQL (RDS). Add ?sslmode=require for RDS.
# METER_DB_URL=postgresql+psycopg2://meter_reader:yourpass@your-rds-endpoint:5432/meter_reader?sslmode=require
# Photos: S3 on AWS (the instance/task role needs s3:PutObject and s3:GetObject), a persistent folder, or none.
# METER_IMAGE_DIR=s3://your-bucket/meter-photos
# The central system's image host(s), comma-separated, or * for any public host.
# METER_IMAGE_URL_ALLOWED_HOSTS=images.jalsoochak.example.org
# Optional: the daily model spend cap in USD. config.yaml already sets 25 (about 1,080 photos a day with GPT-6 Sol at
# ~$0.023 each, more with Claude); production refuses to start only if neither sets a cap. "none" = no cap, on purpose.
# METER_DAILY_BUDGET_USD=25

# ---- The central system's image endpoint ----
# Credentials sent with each photo download (JSON), only to the allowed hosts and only over https (or plain http to a
# private address when METER_ALLOW_PRIVATE_IMAGE_URLS=true). Never put them in the link itself (user:pw@host is refused).
# METER_IMAGE_URL_HEADERS={"Authorization": "Bearer your-token"}
# true when that host is on a private network (same VPC), and for local testing with scripts/run.py --via-url:
# METER_ALLOW_PRIVATE_IMAGE_URLS=false

# ---- Limits (defaults shown) ----
# METER_REQUEST_DEADLINE=100
# Readings at once per worker: 8 fits a 4 GB task with 2 workers; raise it only with more memory
# METER_MAX_CONCURRENT_READS=8
# METER_BUSY_WAIT_SECONDS=30
# METER_MAX_BODY_BYTES=31457280
# Photo request bodies held at once per worker, by Content-Length (150 MB); one more gets 503 "busy, retry"
# METER_MAX_INFLIGHT_BODY_BYTES=157286400
# The same photo of the same consumer again within this many hours: the earlier result, no model call
# (0 = no reuse; a photo whose reading a person marked wrong or corrected is still never read again: it goes to review)
# METER_DUPLICATE_PHOTO_HOURS=168

# ---- Database connections (defaults shown; the timeouts apply to PostgreSQL) ----
# METER_DB_POOL_SIZE=5
# METER_DB_MAX_OVERFLOW=10
# METER_DB_POOL_TIMEOUT=10
# METER_DB_POOL_RECYCLE=1800
# METER_DB_CONNECT_TIMEOUT=5
# METER_DB_STATEMENT_TIMEOUT_MS=15000
# A lost database (failover, network loss) fails within about 15-25 s instead of hanging:
# METER_DB_TCP_USER_TIMEOUT_MS=15000
# Tests only: keep no connections open
# METER_DB_NULL_POOL=false

# ---- docker-compose.yml only ----
# POSTGRES_PASSWORD=choose-a-password

# ---- Optional overrides of config.yaml ----
# The model and effort of the provider in use (with METER_PROVIDER=claude: claude-sonnet-5-5; low|medium|high|xhigh|max)
# METER_MODEL=gpt-6-sol
# METER_REASONING_EFFORT=high
# METER_READS=1
# METER_MIN_CONFIDENCE=0.90
# METER_CLEAR_READ_CONFIDENCE=0.95
# METER_MAX_DAILY_INCREASE=300
# METER_TYPES_FILE=/app/src/conf/meter_types.json
# METER_NAIVE_TIME_OFFSET=+05:30
# METER_ERRORS_AS_HTTP_200=false
# METER_DOCS_ENABLED=false
# METER_LOG_FORMAT=json
# METER_LOG_TO_FILES=false
# CONFIG_PATH=/path/to/another/config.yaml

# ---- Gunicorn (gunicorn.conf.py; it reads this .env too, and variables already set win) ----
# WORKERS=2
# KEEPALIVE=130
# Replace each worker after this many requests (0 = never, the default: memory stays flat without it)
# MAX_REQUESTS=0
